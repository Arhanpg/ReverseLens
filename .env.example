# Change both values before using beyond a disposable local environment.
POSTGRES_PASSWORD=replace-with-a-long-random-password
REVERSE_LENS_WORKER_TOKEN=replace-with-a-long-random-token

# Optional private/self-hosted MobSF API. Leave blank to keep MobSF disabled.
MOBSF_URL=
MOBSF_API_KEY=
MOBSF_ALLOWED_HOSTS=mobsf
