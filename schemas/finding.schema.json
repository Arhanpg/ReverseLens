{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reverselens.dev/schemas/finding.schema.json",
  "title": "ReverseLens Finding",
  "description": "A triaged claim based on one or more observations and evidence artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "finding_id", "run_id", "title", "category", "severity", "confidence", "status", "observation_ids", "evidence_artifact_ids", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "finding_id": { "type": "string", "minLength": 3, "maxLength": 128 },
    "run_id": { "type": "string", "minLength": 3, "maxLength": 128 },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "description": { "type": "string", "maxLength": 10000 },
    "category": { "type": "string", "minLength": 2, "maxLength": 100 },
    "severity": { "enum": ["informational", "low", "medium", "high", "critical", "not_assessed"] },
    "confidence": { "enum": ["low", "medium", "high", "unknown"] },
    "status": { "enum": ["unreviewed", "confirmed", "false_positive", "accepted_risk", "needs_more_evidence"] },
    "observation_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "evidence_artifact_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "affected_locations": { "type": "array", "items": { "type": "string", "maxLength": 2048 } },
    "owasp_mappings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 100 } },
    "created_at": { "type": "string", "format": "date-time" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "reviewer_notes": { "type": "string", "maxLength": 4000 }
  }
}