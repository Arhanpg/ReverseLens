{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reverselens.dev/schemas/engine-registry.schema.json",
  "title": "ReverseLens Engine Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "updated_at", "engines"],
  "properties": {
    "registry_version": { "const": "1.0.0" },
    "updated_at": { "type": "string", "format": "date" },
    "engines": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "engine.schema.json" }
    }
  }
}