{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reverselens.dev/schemas/analysis-run.schema.json",
  "title": "ReverseLens Analysis Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "target_id", "selection_mode", "selected_engine_ids", "status", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 3, "maxLength": 128 },
    "target_id": { "type": "string", "minLength": 3, "maxLength": 128 },
    "selection_mode": { "enum": ["single", "selected_subset", "all_compatible", "benchmark_profile", "version_matrix"] },
    "selected_engine_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" } },
    "benchmark_experiment_id": { "type": "string", "maxLength": 128 },
    "status": { "enum": ["created", "queued", "running", "partial", "succeeded", "failed", "cancelled"] },
    "created_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "configuration": { "type": "object", "additionalProperties": true },
    "host_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": { "type": "string", "maxLength": 100 },
        "architecture": { "type": "string", "maxLength": 64 },
        "cpu_model": { "type": "string", "maxLength": 200 },
        "memory_bytes": { "type": "integer", "minimum": 0 },
        "runtime_versions": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "notes": { "type": "string", "maxLength": 4000 }
  }
}