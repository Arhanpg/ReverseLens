{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reverselens.dev/schemas/observation.schema.json",
  "title": "ReverseLens Observation",
  "description": "A normalized fact reported by an engine. An observation is not automatically a security finding.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "run_id", "engine_execution_id", "category", "title", "observed_at", "evidence"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "observation_id": { "type": "string", "minLength": 3, "maxLength": 128 },
    "run_id": { "type": "string", "minLength": 3, "maxLength": 128 },
    "engine_execution_id": { "type": "string", "minLength": 3, "maxLength": 128 },
    "category": { "enum": ["package_metadata", "technology", "source_symbol", "component", "permission", "route", "endpoint", "network_event", "dependency", "tracker", "binary_symbol", "performance", "other"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "description": { "type": "string", "maxLength": 8000 },
    "observed_at": { "type": "string", "format": "date-time" },
    "confidence": { "enum": ["low", "medium", "high", "unknown"] },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": { "type": "string" },
        "relative_path": { "type": "string", "maxLength": 2048 },
        "symbol": { "type": "string", "maxLength": 512 },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "format": "uri", "maxLength": 2048 },
        "network_event_id": { "type": "string", "maxLength": 128 }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "evidence_type"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "evidence_type": { "enum": ["raw_output", "source_excerpt", "metadata", "network_record", "tool_log", "screenshot", "ground_truth"] },
          "excerpt": { "type": "string", "maxLength": 4000 },
          "json_pointer": { "type": "string", "maxLength": 1024 }
        }
      }
    },
    "attributes": { "type": "object", "additionalProperties": true }
  }
}