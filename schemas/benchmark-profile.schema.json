{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reverselens.dev/schemas/benchmark-profile.schema.json",
  "title": "ReverseLens Benchmark Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_key", "name", "platform", "capability_classes", "engine_ids", "default_repetitions", "default_concurrency"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "profile_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "platform": { "enum": ["android", "web", "native", "cross_platform"] },
    "capability_classes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 100 } },
    "engine_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" } },
    "default_repetitions": { "type": "integer", "minimum": 1, "maximum": 50 },
    "default_concurrency": { "const": 1 },
    "description": { "type": "string", "maxLength": 3000 }
  }
}